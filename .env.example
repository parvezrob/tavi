# The host binds to localhost by default. Keep it this way with Tailscale Serve.
TAVI_HOST=127.0.0.1
TAVI_PORT=8787

# Optional. If omitted, a strong token is generated in ~/.tavi/config.json.
# TAVI_TOKEN=replace-with-a-long-random-value

# Comma-separated folders whose immediate children are shown as launch targets.
# TAVI_ROOTS=/Users/you/Code,/Users/you/Projects

# Optional command overrides.
# TAVI_TMUX_BIN=/opt/homebrew/bin/tmux
# TAVI_SHELL=/bin/zsh
