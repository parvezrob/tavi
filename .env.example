# The host binds to localhost by default. Keep it this way with Tailscale Serve.
DECK_HOST=127.0.0.1
DECK_PORT=8787

# Optional. If omitted, a strong token is generated in ~/.agent-deck/config.json.
# DECK_TOKEN=replace-with-a-long-random-value

# Comma-separated folders whose immediate children are shown as launch targets.
# DECK_ROOTS=/Users/you/Code,/Users/you/Projects

# Optional command overrides.
# DECK_TMUX_BIN=/opt/homebrew/bin/tmux
# DECK_SHELL=/bin/zsh

