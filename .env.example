# The host binds to localhost by default. Keep it this way with Tailscale Serve.
MOCHA_HOST=127.0.0.1
MOCHA_PORT=8787

# Optional. If omitted, a strong token is generated in ~/.mocha/config.json.
# MOCHA_TOKEN=replace-with-a-long-random-value

# Comma-separated folders whose immediate children are shown as launch targets.
# MOCHA_ROOTS=/Users/you/Code,/Users/you/Projects

# Optional command overrides.
# MOCHA_TMUX_BIN=/opt/homebrew/bin/tmux
# MOCHA_SHELL=/bin/zsh
