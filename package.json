{
  "name": "mocha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @mocha/host",
    "check": "npm run check --workspace @mocha/host",
    "dev": "npm run dev --workspace @mocha/host",
    "dev:host": "npm run dev --workspace @mocha/host",
    "postinstall": "node scripts/ensure-node-pty.mjs",
    "service:install": "npm run service:install --workspace @mocha/host",
    "service:uninstall": "npm run service:uninstall --workspace @mocha/host",
    "start": "npm run start --workspace @mocha/host",
    "test": "npm run test --workspace @mocha/host",
    "token": "npm run token --workspace @mocha/host"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  },
  "engines": {
    "node": ">=20"
  }
}
