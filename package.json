{
  "name": "tavi-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace tavi-host",
    "check": "npm run check --workspace tavi-host",
    "check:lengths": "node scripts/check-file-lengths.mjs",
    "dev": "npm run dev --workspace tavi-host",
    "dev:host": "npm run dev --workspace tavi-host",
    "devices": "npm run devices --workspace tavi-host",
    "doctor": "npm run doctor --workspace tavi-host",
    "format": "npm run format --workspace tavi-host",
    "lint": "npm run lint --workspace tavi-host",
    "pair": "npm run pair --workspace tavi-host",
    "postinstall": "node apps/host/scripts/ensure-node-pty.mjs",
    "service:install": "npm run service:install --workspace tavi-host",
    "service:uninstall": "npm run service:uninstall --workspace tavi-host",
    "start": "npm run start --workspace tavi-host",
    "test": "npm run test --workspace tavi-host",
    "token": "npm run token --workspace tavi-host"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.2.0-beta.15": true
  },
  "engines": {
    "node": ">=20"
  }
}
