{
  "name": "tavi-host",
  "version": "0.1.0",
  "description": "Tavi host \u2014 pairs your iPhone with the coding agents already running on this computer, over your own Tailscale network. Terminal Agent Vantage and Intervention, by Farfield.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/parvezrob/mocha.git",
    "directory": "apps/host"
  },
  "homepage": "https://github.com/parvezrob/mocha#readme",
  "bugs": "https://github.com/parvezrob/mocha/issues",
  "type": "module",
  "bin": {
    "tavi": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "scripts/ensure-node-pty.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "devices": "node dist/index.js devices",
    "doctor": "node dist/index.js doctor",
    "hooks:install": "node dist/index.js install-claude-hooks",
    "pair": "node dist/index.js pair",
    "postinstall": "node scripts/ensure-node-pty.mjs",
    "prepublishOnly": "npm run build && npm test",
    "service:install": "node dist/index.js install-service",
    "service:uninstall": "node dist/index.js uninstall-service",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/**/*.test.ts",
    "token": "tsx src/index.ts token"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5"
  }
}
